{
  "name": "harness-swarm",
  "version": "0.1.0",
  "description": "Codex plugin: dispatch qodercli, kimi, pi, grok, codex, claude, dsh, and opencode into isolated git worktrees",
  "type": "module",
  "bin": {
    "harness-swarm": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
